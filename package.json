{
  "name": "timo-feeling-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts",
    "check": "npm run fmt:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  }
}
